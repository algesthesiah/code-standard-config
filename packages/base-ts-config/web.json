{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Web Package",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": false,
    "moduleResolution": "bundler",
    "types": ["vite/client", "vike-react"],
    "declaration": false
  }
}
