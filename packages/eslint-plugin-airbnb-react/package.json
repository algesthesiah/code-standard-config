{
  "name": "eslint-plugin-airbnb-react",
  "version": "2.4.9",
  "description": "custom ESLint config, for react and ts, depends on airbnb, plugin-react, plugin-prettier and so on",
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "airbnb",
    "javascript",
    "styleguide",
    "react",
    "ts",
    "custom"
  ],
  "repository": "https://github.com/algesthesiah/eslint-plugin-airbnb-react",
  "license": "MIT",
  "author": "algesthesiah https://github.com/algesthesiah",
  "type": "module",
  "scripts": {
    "build": "pnpm unbuild"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "peerDependencies": {
    "@eslint/js": "9.39.1 ",
    "@types/eslint": "9.6.1",
    "@types/node": "^24.10.1",
    "base-ts-config": "^2.0.1",
    "eslint": "9.39.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.6.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-command": "3.3.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-eslint-plugin": "7.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-jsdoc": "61.4.1",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-translation-safe": "1.1.7",
    "eslint-plugin-regexp": "2.10.0",
    "eslint-plugin-rtl-friendly": "^0.5.1",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "eslint-plugin-vitest": "0.5.4",
    "globals": "16.5.0",
    "jsonc-eslint-parser": "2.4.1",
    "prettier": "3.7.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {}
